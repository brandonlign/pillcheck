{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pillcheck",
  "provider": {
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{file:./.opencode/nvidia-api-key}"
      },
      "models": {
        "z-ai/glm-5.3": {
          "name": "GLM-5.3",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  }
}
